# NyayaSetu Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Flask secret key — generate a strong random string for production.
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key

# Flask environment: development | production
FLASK_ENV=development

# Set to 0 in production
FLASK_DEBUG=1

# SQLite database path (relative to project root)
DATABASE_URL=sqlite:///nyayasetu.db

# --- Gemini API (Phase 2) ---
# Get your key from: https://aistudio.google.com/app/apikey
# REQUIRED for AI-powered problem-to-guidance analysis.
# Without this key the app falls back to keyword-based classification.
GEMINI_API_KEY=your-gemini-api-key-here
