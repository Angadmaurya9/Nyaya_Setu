# Normalise line endings to LF in the repository, checkout as CRLF on Windows.
* text=auto

# Python files always LF
*.py   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.cfg  text eol=lf
*.env* text eol=lf

# Binary files — no line-ending conversion
*.db   binary
*.png  binary
*.jpg  binary
*.ico  binary
